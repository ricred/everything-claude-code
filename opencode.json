{
  "$schema": "https://opencode.ai/config.json",

  "model": "zai-coding-plan/glm-4.7",

  "default_agent": "build",

  "agent": {
    "planner": {
      "description": "Plans project structure and architecture",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny"
      }
    },
    "architect": {
      "description": "Designs system architecture and patterns",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny"
      }
    },
    "tdd-guide": {
      "description": "Guides test-driven development with full permissions",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny"
      }
    },
    "security-reviewer": {
      "description": "Reviews code for security vulnerabilities",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny"
      }
    }
  },

  "compaction": {
    "auto": false
  }
}
